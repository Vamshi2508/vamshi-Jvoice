{
  "rules": {
    "users": {
      ".read": false,
      ".write": false,

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'news_admin' || root.child('users').child(auth.uid).child('role').val() === 'study_admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",

        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
          ".validate": "newData.isString() && newData.val().matches(/^(reporter|editor|news_admin|content_creator|exam_admin|study_admin|super_admin)$/)"
        },

        "isLogin": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'news_admin' || root.child('users').child(auth.uid).child('role').val() === 'study_admin')",
          ".validate": "newData.isBoolean()"
        },

        "lastLoginAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },

        "forceLogoutAt": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'news_admin' || root.child('users').child(auth.uid).child('role').val() === 'study_admin')",
          ".validate": "newData.isNumber()"
        },

        "update": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
          "force": { ".validate": "newData.isBoolean()" },
          "version": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "flags": {
      // App-level feature switches. World-readable on purpose: every reader is
      // anonymous, and a flag the app cannot read is a flag that does nothing.
      // Nothing sensitive belongs here - only which controls are visible.
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
      "$flag": { ".validate": "newData.isBoolean()" }
    },

    "failedLoginAttempts": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'news_admin')",

      "$deviceId": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['deviceId', 'loginId', 'attempts'])",
        "deviceId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "loginId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "attempts": { ".validate": "newData.isNumber()" },
        "lastAttemptAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "passwordResetRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'news_admin')",

      "$phone": {
        ".write": "newData.exists()",
        ".validate": "$phone.matches(/^[0-9]{10,15}$/) && newData.hasChildren(['phone', 'requests'])",
        "phone": { ".validate": "newData.isString() && newData.val().length <= 15" },
        "requests": { ".validate": "newData.isNumber()" },
        "lastRequestedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
