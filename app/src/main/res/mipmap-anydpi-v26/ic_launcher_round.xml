<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon.

  The foreground is the supplied logo artwork, cropped to the J and the globe and
  scaled to sit inside the adaptive safe zone. The full lockup cannot be used
  here: a launcher icon is masked to a circle or squircle at around 48dp, and the
  wordmark and tagline would be cropped away and illegible even if they were not.

  The plate colour lives in `background` rather than being baked into the PNG, so
  the launcher can parallax the two layers independently.

  `monochrome` stays a vector. Android tints that layer flat to match the
  wallpaper, and a photographic crop tinted to one colour is a blob - the themed
  icon needs a silhouette, which only the vector provides.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/jv_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
