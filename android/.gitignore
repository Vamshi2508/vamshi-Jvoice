*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# The original '/build' above is anchored to the project root, so it misses
# the module output at 'app/build' - which is where a Gradle build actually
# writes. Unanchored, this catches every module's build directory.
build/
.kotlin/
*.apk
*.aab

# Release signing material. Committing either of these would hand anyone with
# repo access the ability to sign builds as J Voice. Keep both backed up
# OFF this machine - losing them means you cannot ship an update under the
# same upload key.
*.jks
*.keystore
keystore.properties
